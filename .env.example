# ROTC Management System local environment example
#
# Copy this to your machine-specific environment or create
# includes/db_config.local.php from includes/db_config.local.php.example.

ROTC_DB_TYPE=mysql
ROTC_DB_SERVER=localhost:3306
ROTC_DB_USER=root
ROTC_DB_PASS=
ROTC_DB_NAME=rotc_db

# Preferred on hosted/serverless platforms such as Vercel.
# This must point to an internet-reachable database host, not localhost.
DATABASE_URL=mysql://user:password@db.example.com:3306/rotc_db

# Public base URL used in links and redirects when needed.
ROTC_APP_BASE_URL=http://localhost/generate%20qr
ROTC_DEBUG=false

# Optional document-generation Python service values.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/rotc_db
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=rotc_db
DATABASE_USER=root
DATABASE_PASSWORD=
